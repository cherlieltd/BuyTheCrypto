# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# https://supabase.com/docs/guides/auth/server-side/nextjs
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Transak — https://docs.transak.com
# staging uses api-stg.transak.com and api-gateway-stg.transak.com
# production uses api.transak.com and api-gateway.transak.com
TRANSAK_ENV=staging
TRANSAK_API_KEY=YOUR_TRANSAK_API_KEY
TRANSAK_API_SECRET=YOUR_TRANSAK_API_SECRET
# Optional. When omitted, the server calls POST /partners/api/v2/refresh-token.
TRANSAK_ACCESS_TOKEN=
TRANSAK_REFERRER_DOMAIN=buythecrypto.com

# CoinGecko — https://docs.coingecko.com/docs/authentication
# demo: header x-cg-demo-api-key, base https://api.coingecko.com/api/v3
# pro:  header x-cg-pro-api-key,  base https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo

# Resend — https://resend.com/docs
RESEND_API_KEY=
SUPPORT_EMAIL_FROM="BuyTheCrypto <support@buythecrypto.com>"
SUPPORT_EMAIL_TO=support@buythecrypto.com

# Upstash Redis — https://upstash.com/docs/redis/sdks/ratelimit-ts/overview
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — https://www.inngest.com/docs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry — https://docs.sentry.io/platforms/javascript/guides/nextjs/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog — https://posthog.com/docs/libraries/next-js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
